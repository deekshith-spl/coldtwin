{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "api/**/*.ts",
    "src/whatsapp/**/*.ts",
    "src/engine/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "src/engine/__tests__"
  ]
}